# ==============================================================================
# TenderForge Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME=TenderForge
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Database Settings
# Supports SQLite for local dev/testing: sqlite:///./tenderforge.db
# Or PostgreSQL for production: postgresql+psycopg2://user:password@localhost:5432/tenderforge
DATABASE_URL=sqlite:///./tenderforge.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Storage Settings
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
TEMP_STORAGE_ROOT=./temp_uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Document Processing Settings
CONFIG_PATH_APP=./config/application.yaml
CONFIG_PATH_DOC_PROCESSING=./config/document_processing.yaml
PROMPTS_DIR=./config/prompts

# AI Provider Settings
# Supported providers: mock, openai, gemini, anthropic, ollama
# When AI_PROVIDER is set to empty or 'none', document processing works normally
# and intelligence extraction returns 'ai_configuration_required' without fabricating data.
AI_PROVIDER=mock
AI_MODEL_NAME=gpt-4o
AI_API_KEY=
AI_API_BASE_URL=
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60.0
AI_MAX_RETRIES=2

